# Copy to .env and replace every placeholder. Never commit .env.
#
#   cp .env.example .env
#
# Generate every secret with: openssl rand -hex 32

# Sandbox service release. The API, runner, and sandbox images ship as ONE release and
# are only supported together, so this single pin covers all three.
# Latest stable: https://github.com/n8n-io/n8n-sandbox-service/releases
N8N_SANDBOX_VERSION=1.15.0

# Secrets shared between the sandbox services and n8n.
# SANDBOX_API_KEYS is the set of keys the API accepts; N8N_SANDBOX_SERVICE_API_KEY (in
# n8n/.env) must be ONE of those values, byte for byte.
SANDBOX_API_KEYS=replace-with-random-api-key

# The API and the runner read DIFFERENT variable names for the same two secrets, and each
# pair must match byte for byte. The upstream .env template only documents the runner-side
# names, which leaves the API unable to start ("SANDBOX_API_RUNNER_REGISTRATION_TOKEN must
# be set"). Both sides are listed here for that reason.
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=replace-with-random-registration-token
SANDBOX_RUNNER_REGISTRATION_TOKEN=replace-with-random-registration-token
SANDBOX_API_RUNNER_API_KEY=replace-with-random-runner-key
SANDBOX_RUNNER_API_KEYS=replace-with-random-runner-key

# LAN-only hostnames. Both are one-label subdomains covered by the existing
# *.lexcode.dev DNS-01 wildcard. Do not create Cloudflare Tunnel routes for them.
#
# SearXNG web UI + the JSON search API n8n Assistant uses.
N8N_SEARXNG_HOSTNAME=n8n-searxng.lexcode.dev
# sandbox-api control plane. Bearer-token authenticated; for probing/testing from a LAN
# machine only. n8n itself uses http://sandbox-api:8080 over the Docker network.
N8N_SANDBOX_API_HOSTNAME=n8n-sandbox-api.lexcode.dev

# Secret for the bundled SearXNG instance.
SEARXNG_SECRET=replace-with-random-searxng-secret

# NOTE: the shared network is owned and subnet-configured by the `n8n/` stack
# (N8N_SANDBOX_SUBNET there). This stack only joins it as an external network.

# Optional memory ceilings (Docker Compose mem_limit syntax). These exist because this
# host is a Raspberry Pi 5 with 8 GB shared across ~50 containers. Raise them if sandbox
# code execution is OOM-killed; lower them if the host is under pressure.
SANDBOX_API_MEM_LIMIT=512m
SANDBOX_RUNNER_MEM_LIMIT=1536m
SEARXNG_MEM_LIMIT=256m
