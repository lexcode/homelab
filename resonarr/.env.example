# Pin a published GHCR SHA tag after PR #21 has merged and published it.
RESONARR_IMAGE=ghcr.io/lexcode/resonarr-backend:sha-replace-with-published-commit

# Public API name routed by Traefik. This one-label subdomain is covered by the
# documented *.lexcode.dev wildcard certificate and DNS wildcard.
RESONARR_HOSTNAME=resonarr.lexcode.dev
SPOTIFY_REDIRECT_URI=https://resonarr.lexcode.dev/spotify/callback
# The separate Vercel frontend origin allowed by CORS and used after Spotify connects.
RESONARR_WEB_ORIGIN=https://resonarr.example.com

# The permanent library is shared by both containers. Resonarr writes this directly; do not mount
# media/beets' inbox here.
RESONARR_MUSIC_HOST_PATH=/srv/resonarr/music

SPOTIFY_CLIENT_ID=replace-me
SPOTIFY_CLIENT_SECRET=replace-me
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
RESONARR_ADMIN_EMAIL=operator@example.com
RESONARR_ADMIN_PASSWORD=replace-with-at-least-12-characters
