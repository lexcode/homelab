# AdGuard Home — see README.md
ADGUARD_SUBNET=172.39.5.0/24
# Static IP on the Docker bridge (same idea as `docker run --ip`); must be inside ADGUARD_SUBNET (not your LAN IP).
ADGUARD_IP=172.39.5.2

# Host port for DNS (maps to container 53). Use 5353 if something else already binds 53 on the host.
ADGUARD_DNS_PORT=53

# Web UI (HTTP). Default 3005 avoids clashing with Nginx Proxy Manager (80/443) on the same machine.
ADGUARD_HTTP_PORT=3005

TZ=Europe/Dublin