# LAN-only hostname. This one-label subdomain is covered by the existing
# *.lexcode.dev DNS-01 wildcard certificate. Do not create a Cloudflare Tunnel route for it.
TM_HOSTNAME=tesla.lexcode.dev
TZ=Europe/Dublin

# Generate with: openssl rand -base64 48
# Keep this value: TeslaMate uses it to encrypt Tesla API tokens stored in PostgreSQL.
TM_ENCRYPTION_KEY=replace-with-a-random-encryption-key

TM_DB_USER=teslamate
# Generate with: openssl rand -base64 32
TM_DB_PASSWORD=replace-with-a-strong-database-password
TM_DB_NAME=teslamate

# Grafana is available at https://tesla.lexcode.dev/grafana and requires a login.
TM_GRAFANA_USER=admin
# Generate with: openssl rand -base64 32
TM_GRAFANA_PASSWORD=replace-with-a-strong-grafana-password

# PostgreSQL backup retention (the database is also the only durable store for Tesla API tokens).
TM_DB_BACKUP_KEEP_DAYS=7
TM_DB_BACKUP_KEEP_WEEKS=4
TM_DB_BACKUP_KEEP_MONTHS=6
