# Gotify — see README.md and https://gotify.net/docs/install
# Host port maps to container HTTP (80).
GOTIFY_HTTP_PORT=8688

# Initial admin password (used on first start only; change in the UI after login).
GOTIFY_DEFAULTUSER_PASS=changeme

# Container timezone (logs, scheduled tasks).
TZ=UTC

# iGotify assistant — Local instance: set all three (Gotify UI → Clients + app tokens).
# External instance (public Gotify + public iGotify URLs in the app): leave all three empty.
GOTIFY_URLS=http://gotify:80
GOTIFY_CLIENT_TOKENS=
SECNTFY_TOKENS=

# iGotify HTTP Port
IGOTIFY_HTTP_PORT=8681