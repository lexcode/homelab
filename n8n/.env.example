# LAN-only hostname. This one-label subdomain is covered by the existing
# *.lexcode.dev DNS-01 wildcard certificate. Do not create a Cloudflare Tunnel route for it.
N8N_HOSTNAME=n8n.lexcode.dev
TZ=Europe/Dublin

# Generate with: openssl rand -base64 48 (at least 32 characters)
# Keep this value: n8n uses it to encrypt workflow credentials stored in SQLite.
N8N_ENCRYPTION_KEY=replace-with-a-random-encryption-key
