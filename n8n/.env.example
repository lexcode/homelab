# LAN-only hostname. This one-label subdomain is covered by the existing
# *.lexcode.dev DNS-01 wildcard certificate. Do not create a Cloudflare Tunnel route for it.
N8N_HOSTNAME=n8n.lexcode.dev
TZ=Europe/Dublin

# Generate with: openssl rand -base64 48 (at least 32 characters)
# Keep this value: n8n uses it to encrypt workflow credentials stored in SQLite.
N8N_ENCRYPTION_KEY=replace-with-a-random-encryption-key

# --- n8n Assistant (optional) -------------------------------------------------------
# The code-execution sandbox runs in the sibling `n8n-sandbox/` stack. Start that stack
# first, then set ENABLED=true here and restart this one.
N8N_INSTANCE_AI_SANDBOX_ENABLED=false
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080

# Subnet for n8n-sandbox-network, which this stack creates. Must not overlap media
# (172.39.0.0/24), monitoring (.1), analytics (.2), dns (.5) or management (.8).
N8N_SANDBOX_SUBNET=172.39.9.0/24

# Must match a value in SANDBOX_API_KEYS in n8n-sandbox/.env, byte for byte.
N8N_SANDBOX_SERVICE_API_KEY=

# Model provider in provider/model form: anthropic, openai, or openrouter.
# n8n 2.47.4 defaults to anthropic/claude-opus-4-8; set this explicitly to choose.
# N8N_INSTANCE_AI_MODEL=anthropic/claude-opus-4-8
# N8N_INSTANCE_AI_MODEL_API_KEY=

# Web search. SearXNG is bundled in n8n-sandbox/; point at it by service name.
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080
# Brave Search takes priority over SearXNG when set. Note: no N8N_ prefix.
# INSTANCE_AI_BRAVE_SEARCH_API_KEY=

# Traefik sits exactly one hop in front of n8n. Set to the number of proxies between the
# client and n8n, or Express cannot identify clients and rate limiting misbehaves.
N8N_PROXY_HOPS=1
