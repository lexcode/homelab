# Cloudflare Tunnel token — from Zero Trust dashboard → Networks → Tunnels → your tunnel → Configure
CLOUDFLARED_TOKEN=YOUR_TUNNEL_TOKEN

# Email for Let's Encrypt account registration (Traefik's ACME resolver).
# Used only for expiry/revocation notices — not a login, no verification required.
ACME_EMAIL=you@example.com

# Cloudflare API token for Traefik's DNS-01 challenge (requests one *.yourdomain.com wildcard
# cert, reused for every host regardless of whether that specific subdomain is publicly
# routable). Create at Cloudflare dashboard → My Profile → API Tokens → Create Token → "Edit
# zone DNS" template, scoped to just your zone. Needs Zone:DNS:Edit — nothing else.
CF_DNS_API_TOKEN=YOUR_CLOUDFLARE_DNS_EDIT_TOKEN

# Basicauth credentials guarding the Traefik dashboard at traefik.<yourdomain>. The dashboard
# and its /api have no authentication of their own, so this is the only thing protecting them
# from anyone on the LAN. Format is `user:hash` (comma-separate for multiple users). Generate:
#   openssl passwd -apr1 'your-password'      # then prefix with `user:`
# Then double every `$` in the hash: Compose interpolates .env values, so a literal `$apr1$abc$xyz`
# is read as the (empty) variables $apr1/$abc and the salt is silently stripped — auth then always
# fails with no useful error. Write `$$apr1$$abc$$xyz`.
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$REPLACE$$WITH_YOUR_HASH

# -----------------------------------------------------------------------------
# Tailscale Funnel (optional) — publicly expose one service via Tailscale edge
# without port forwarding and without Cloudflare in the video path.
# Generate a reusable auth key at https://login.tailscale.com/admin/settings/keys
# (recommended: Reusable = true, Ephemeral = false, tag:funnel).
# -----------------------------------------------------------------------------
TS_AUTHKEY=

# MagicDNS hostname — becomes https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=jellyfin

# Extra args passed to `tailscale up`. `--accept-dns=false` keeps the container
# using Docker's DNS (so it can still resolve `nginx-proxy-manager` on proxynetwork).
TS_EXTRA_ARGS=--accept-dns=false
