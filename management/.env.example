# Absolute path to this repository on the Docker host.
# Dockge requires this path to be identical inside and outside the container.
HOMELAB_ROOT=/home/lexcode/git/homelab

# Dockge listens on 5001 in the container. Use 5002 on the host because
# notifications/changedetection already publishes port 5001.
DOCKGE_PORT=5002

# Change this if it overlaps another Docker network or your LAN.
MANAGEMENT_SUBNET=172.39.8.0/24
