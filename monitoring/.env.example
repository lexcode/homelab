# Monitoring
MONITORING_SUBNET=172.39.1.0/24

# Beszel
BESZEL_IP=172.39.1.2
BESZEL_PORT=8090
BESZEL_LOG_LEVEL=info
BESZEL_URL=http://localhost:8090

# Beszel Agent
BESZEL_AGENT_KEY='ssh-edXXXXX KEYXXXXX'
BESZEL_AGENT_TOKEN=XXXXX-TOKENXXXXX
BESZEL_AGENT_LISTEN=45876
BESZEL_AGENT_LOG_LEVEL=info


# Dozzle
DOZZLE_IP=172.39.1.3
# Friendly name shown in the UI for this machine
DOZZLE_HOSTNAME=
# Comma-separated list of remote agents to connect to (other machines running dozzle-agent)
# Do NOT include this machine's own IP — only the other hosts
# e.g. DOZZLE_REMOTE_AGENT=192.168.0.x:7007,192.168.0.x:7007
DOZZLE_REMOTE_AGENT=

# Start/stop/restart/remove/update containers from the Dozzle UI (default: true).
# Also controls whether this machine's dozzle-agent accepts actions. Set to false
# to make Dozzle read-only. Anyone who can reach Dozzle can use the actions, so
# keep it LAN-only or put authentication in front of it before exposing it.
DOZZLE_ENABLE_ACTIONS=true
