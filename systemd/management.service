[Unit]
Description=Container Management Stack (Dockge)
After=docker.service
Requires=docker.service

[Service]
WorkingDirectory=/home/lexcode/code/homelab/management
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
