[Unit]
Description=Pulsearr Stack
After=docker.service media.service notifications.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=15min
WorkingDirectory=/home/lexcode/git/homelab/pulsearr
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
