[Unit]
Description=Notifications stack (Gotify push notification server)
After=docker.service
Requires=docker.service

[Service]
WorkingDirectory=/home/lexcode/code/homelab/notifications
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
