# Listen on all Raspberry Pi network interfaces.
# Use 127.0.0.1 instead when access is only through a local reverse proxy.
AI_MEMORY_BIND_ADDRESS=0.0.0.0
AI_MEMORY_PORT=49374

# Generate with:
# openssl rand -hex 32
AI_MEMORY_AUTH_TOKEN=

# Replace YOUR_PI_IP with the address clients use to reach this server.
# Add a LAN DNS name or Tailscale name/IP when applicable.
AI_MEMORY_ALLOWED_HOSTS=YOUR_PI_IP,localhost,127.0.0.1

AI_MEMORY_LOG_LEVEL=info
