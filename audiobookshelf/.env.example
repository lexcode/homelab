# Audiobookshelf — copy to `.env` and adjust (see README.md).

TZ=Europe/Dublin

# Owner of ./data/audiobookshelf and the library paths. Match the user/group
# that owns the mounted audiobook share so covers and metadata can be written.
PUID=1000
PGID=1000

# Host port for the web UI (the container listens on 80). This is only for
# direct LAN access; Traefik reaches the container over audiobookshelfnetwork.
AUDIOBOOKSHELF_PORT=13378

# Docker bridge for this stack. Must not overlap media (172.39.0.0/24),
# monitoring (.1), analytics (.2), dns (.5), management (.8) or n8n-sandbox (.9).
AUDIOBOOKSHELF_SUBNET=172.39.10.0/24

# Host library paths bind-mounted into the container as /audiobooks, /ebooks
# and /podcasts. All must exist before the first start. On the Pi, /data holds
# the CIFS-mounted NAS tree — point these at the real shares (or an empty
# folder for any library type you do not use).
AUDIOBOOKSHELF_AUDIOBOOKS_DIR=/data/audiobooks
AUDIOBOOKSHELF_EBOOKS_DIR=/data/ebooks
AUDIOBOOKSHELF_PODCASTS_DIR=/data/podcasts
