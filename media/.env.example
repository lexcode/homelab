PUID=1000
PGID=1000
TZ=Europe/Dublin

# Docker bridge for *arr + vpn; *_IP must fall inside SERVARR_SUBNET (used by compose ipv4_address)
SERVARR_SUBNET=172.39.0.0/24

VPN_IP=172.39.0.2
SONARR_IP=172.39.0.3
RADARR_IP=172.39.0.4
LIDARR_IP=172.39.0.5
BAZARR_IP=172.39.0.6
SEERR_IP=172.39.0.7
SUGGESTARR_IP=172.39.0.8
MAINTAINERR_IP=172.39.0.10
BEETS_IP=172.39.0.11
CHAPTARR_IP=172.39.0.12
# Flaresolverr uses network_mode: service:vpn (no separate IP). From Prowlarr, which shares that
# namespace, the working URL is http://172.39.0.2:8191 (VPN_IP) or http://127.0.0.1:8191.

WEBUI_PORT=8080
TORRENTING_PORT=6881

# Wireguard PIA
VPN_SERVICE_PROVIDER=private internet access # VPN service provider
OPENVPN_USER=username
OPENVPN_PASSWORD=password
SERVER_REGIONS=Ireland # PIA server region
PIA_LOC=ireland,nl_amsterdam,swiss # PIA location(s); comma-separated fallbacks are tried in order
# Optional: DNS lines written into WireGuard config only (not required for startup). Leave unset to use PIA DNS after addKey.
VPNDNS=10.0.0.243,10.0.0.242
LOCAL_NETWORK=192.168.0.0/24 # Local network

# Optional service logging
SEERR_LOG_LEVEL=info

# SuggestArr uses network_mode: host in compose — listens on the host (SUGGESTARR_PORT).
# SUGGESTARR_IP is unused for that service; Jellyfin URL in the UI is still http://<jellyfin-host>:8096
SUGGESTARR_PORT=5000
SUGGESTARR_LOG_LEVEL=info

MAINTAINERR_PORT=6246
# MAINTAINERR_GITHUB_TOKEN=ghp_yourtoken # Optional: GitHub PAT for higher API rate limits (60/hr without, 5000/hr with)

# Chaptarr (audiobook/ebook manager, Readarr fork) — web UI port on the host.
CHAPTARR_PORT=8789

# slskd (Soulseek) — two different credential pairs:
#   SLSK_*  is your Soulseek network account. There is no web sign-up on slsknet.org:
#           the account is created from a Soulseek client's login window (SoulseekQt).
#   SLSKD_* is the slskd web UI login; upstream's default is slskd/slskd, so set this.
SLSK_USERNAME=your_soulseek_username
SLSK_PASSWORD=your_soulseek_password
SLSKD_USERNAME=admin
SLSKD_PASSWORD=change-me-slskd-password
# The Soulseek listening port (50300) is deliberately not published: PIA forwards a single
# port per account and qBittorrent's port-sync hook owns it, so slskd runs firewalled behind
# the VPN. What that costs, and how to change it, is in media/README.md -> Soulseek.

# Beets — host paths bind-mounted into the beets container as /music-inbox and /music.
# Both are expected to be CIFS mounts of the Unraid shares (see media/README.md).
MUSIC_INBOX_DIR=/data/music-inbox
MUSIC_LIBRARY_DIR=/data/music-unraid
