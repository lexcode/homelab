ATUIN_DB_NAME=
ATUIN_DB_USERNAME=
# Choose your own secure password
ATUIN_DB_PASSWORD=

# Account creation. Closed by default because atuin.lexcode.dev is publicly routed through
# the Cloudflare Tunnel. Set true only for the run that creates your own account, then back
# to false — otherwise any internet client can register on the history store.
ATUIN_OPEN_REGISTRATION=false