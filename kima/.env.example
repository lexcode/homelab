# Kima (Unraid) — copy to `.env` next to compose.yml, or rely on the defaults
# baked into compose.yml. Unraid's Docker Compose UI pastes compose.yml directly
# and reads .env from the same folder.

# Image tag. `latest` is the stable channel (pre-releases never move it); pin a
# release tag (e.g. v1.13.0) for reproducible upgrades.
KIMA_VERSION=latest

# Host paths on the Unraid server.
KIMA_MUSIC_PATH=/mnt/user/Media/Music
KIMA_DATA_PATH=/mnt/user/appdata/kima

# Published host port — the proxy reaches Kima at http://192.168.0.149:3030.
KIMA_PORT=3030

TZ=Europe/Dublin

# true (default): session cookies only sent over HTTPS. Set false for plain
# HTTP access.
KIMA_SECURE_COOKIES=true

# How Lidarr reaches Kima. With Lidarr in the repo's media stack (another
# host), use the LAN address; with Lidarr on the same host,
# http://host.docker.internal:3030 works.
KIMA_CALLBACK_URL=http://192.168.0.149:3030

# 1 disables the vibe (sound-vector) analyzer for low-CPU/low-RAM hosts.
DISABLE_CLAP=

# Memory guardrails (upstream defaults). Lower for low-RAM hosts.
KIMA_MEM_LIMIT=6g
KIMA_MEMSWAP_LIMIT=8g

# GPU — same variables an Unraid GPU template uses (like Jellyfin). `all` picks
# the single Quadro P620; pin a device UUID from `nvidia-smi -L` if needed.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all
