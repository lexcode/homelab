# Listen on all Raspberry Pi network interfaces.
# Use 127.0.0.1 instead when access is only through a local reverse proxy.
AI_MEMORY_BIND_ADDRESS=0.0.0.0
AI_MEMORY_PORT=49374

# Generate with:
# openssl rand -hex 32
AI_MEMORY_AUTH_TOKEN=replace-with-a-long-random-token

# Begin in zero-LLM mode.
AI_MEMORY_LLM_PROVIDER=none
AI_MEMORY_EMBEDDING_PROVIDER=none

AI_MEMORY_LOG_LEVEL=info
